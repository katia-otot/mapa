    {
      "nombre": "Noche de los Lápices",
      "direccion": "Cens.Secundaria., Calle 57, Necochea",
      "coordenadas": [
        -58.738099,
        -38.553769
      ],
      "parrafos": [
        "Mural realizado en conmemoración de los/as estudiantes detenidos desaparecidos durante la Noche de los Lápices por el Movimiento de Artistas y Trabajadores del Espectáculo (M.A.T.E.) en el año 2008, restaurado por el Movimiento Evita en el año 2015."
      ],
